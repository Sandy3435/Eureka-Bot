# Optional custom system prompt (overrides default)
# AI_SYSTEM_PROMPT=

# --- Behavior ---
RATE_LIMIT_PER_MINUTE=20
MAX_HISTORY=8
AUTO_NUDGE=true

# --- Storage ---
DATA_DIR=./data
